# Copy this file to .env and fill in real values before running the server.
# .env is gitignored and must never be committed.

# MongoDB connection string — local mongod (e.g. mongodb://localhost:27017/alpg)
# or a MongoDB Atlas URI.
MONGODB_URI=

# A long, random secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Real OpenAI API key with access to the gpt-4o model.
OPENAI_API_KEY=

# Origin the app is served from (now the same server, since app.js serves
# both the API and the PWA static files together).
CLIENT_ORIGIN=http://localhost:3000

# development | production — controls the Secure flag on the auth cookie.
NODE_ENV=development

PORT=3000
